<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE -->
    <record id="view_bao_gia_tree" model="ir.ui.view">
        <field name="name">bao_gia.tree</field>
        <field name="model">bao_gia</field>
        <field name="arch" type="xml">
            <tree>
                <field name="khach_hang_id"/>
                <field name="nhan_vien_id"/>
                <field name="ngay_tuong_tac"/>
                <field name="tong_tien"/>
                <field name="trang_thai"/>
            </tree>
        </field>
    </record>
    <!-- FORM -->
    <record id="view_bao_gia_form" model="ir.ui.view">
        <field name="name">bao_gia.form</field>
        <field name="model">bao_gia</field>
        <field name="arch" type="xml">
            <form string="Báo giá">
                <sheet>
                    <group>
                        <field name="khach_hang_id"/>
                        <field name="nhan_vien_id"/>
                        <field name="cong_viec_id"/>                       
                    </group>
                    <group string="Thông tin báo giá">
                        <field name="ngay_tuong_tac"/>
                        <field name="tong_tien"/>
                        <field name="trang_thai"/>
                    </group>
                    <group>
                        <field name="ghi_chu"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- GRAPH: Số báo giá theo trạng thái -->
    <record id="view_bao_gia_graph_trang_thai" model="ir.ui.view">
        <field name="name">bao_gia.graph.trang_thai</field>
        <field name="model">bao_gia</field>
        <field name="arch" type="xml">
            <graph string="Báo giá theo trạng thái" type="bar">
                <field name="trang_thai"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>
    <!-- ACTION -->
    <record id="action_bao_gia" model="ir.actions.act_window">
        <field name="name">Báo giá</field>
        <field name="res_model">bao_gia</field>
        <field name="view_mode">tree,form,graph</field>
    </record>
</odoo>